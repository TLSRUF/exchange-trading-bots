# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채우세요.
# .env 파일은 절대 외부에 공유하거나 git에 커밋하지 마세요.

# ── OKX API ─────────────────────────────────────────────────────────────────
# OKX_ENV=demo(기본)일 땐 OKX 앱/웹의 "Demo trading" 메뉴에서 별도로 발급하는 데모 전용
# API 키가 필요함 (실전 키 재사용 불가 — Binance 테스트넷과 비슷한 제약). Bitget처럼
# passphrase도 필요합니다.
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_API_PASSPHRASE=your_api_passphrase_here

# live = 실전, demo = 모의매매(권장 시작점, 위 주석 참고)
OKX_ENV=demo

# 실전(OKX_ENV=live) + DRY_RUN=false 조합으로 켜려면
# 아래 값을 정확히 I_ACCEPT_THE_RISK 로 채워야 함 (config.py의 안전장치). 평소엔 비워두세요.
LIVE_TRADING_CONFIRM=

# ── 거래 설정 ────────────────────────────────────────────────────────────────
# OKX는 심볼 표기가 다른 거래소와 다름 — "BTCUSDT"가 아니라 "BTC-USDT-SWAP"(무기한 스왑).
TRADE_SYMBOL=BTC-USDT-SWAP
MARGIN_MODE=isolated
LEVERAGE=20

# true(기본) = 실제 주문 없이 로그만 남김. 실거래를 하려면 명시적으로 false로 바꿀 것.
DRY_RUN=true

# ── 웹훅 서버 (트레이딩뷰 → 이 서버) ──────────────────────────────────────────
# 트레이딩뷰 얼러트 JSON 메시지에도 이 값과 똑같이 넣어야 함. 없으면 요청이 전부 거부됨.
WEBHOOK_SECRET=change_me_to_a_long_random_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8003

# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
# 발급: 텔레그램에서 @BotFather 검색 → /newbot
# chat_id 확인: 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 호출
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
