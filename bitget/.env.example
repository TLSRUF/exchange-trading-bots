# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채우세요.
# .env 파일은 절대 외부에 공유하거나 git에 커밋하지 마세요.

# ── Bitget API ──────────────────────────────────────────────────────────────
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_api_passphrase_here

# 실전 = USDT-FUTURES, 데모(모의투자, 권장 시작점) = SUSDT-FUTURES
BITGET_PRODUCT_TYPE=SUSDT-FUTURES

# 실전(BITGET_PRODUCT_TYPE=USDT-FUTURES) + DRY_RUN=false 조합으로 켜려면
# 아래 값을 정확히 I_ACCEPT_THE_RISK 로 채워야 함 (config.py의 안전장치). 평소엔 비워두세요.
LIVE_TRADING_CONFIRM=

# ── 거래 설정 ────────────────────────────────────────────────────────────────
TRADE_SYMBOL=BTCUSDT
MARGIN_MODE=isolated
LEVERAGE=20

# true(기본) = 실제 주문 없이 로그만 남김. 실거래를 하려면 명시적으로 false로 바꿀 것.
DRY_RUN=true

# ── 웹훅 서버 (트레이딩뷰 → 이 서버) ──────────────────────────────────────────
# 트레이딩뷰 얼러트 JSON 메시지에도 이 값과 똑같이 넣어야 함. 없으면 요청이 전부 거부됨.
WEBHOOK_SECRET=change_me_to_a_long_random_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
# 발급: 텔레그램에서 @BotFather 검색 → /newbot
# chat_id 확인: 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 호출
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
